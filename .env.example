# =============================================================================
# S.DESIGN SHOP — variables d'environnement
#
# Copiez ce fichier en `.env` et renseignez vos propres valeurs.
# AUCUNE CLE REELLE NE DOIT FIGURER ICI NI DANS LE DEPOT.
# `.env` et `.env*.local` sont exclus par .gitignore.
#
# Architecture de production :
#   Cloudflare (DNS, TLS, proxy, WAF)
#     → serveur Node.js  →  Next.js 14.2.35
#         → PostgreSQL manage
#         → Cloudflare R2   (fichiers persistants)
#         → Brevo           (codes OTP par e-mail)
# =============================================================================


# #############################################################################
#                              DEVELOPPEMENT
#          Ce bloc suffit a faire tourner le projet en local.
# #############################################################################

# Base SQLite locale (provider = "sqlite" dans prisma/schema.prisma)
DATABASE_URL="file:./sdesign.db"

# Inutilisee tant que le provider est "sqlite".
DATABASE_URL_UNPOOLED=

# Signe les sessions JWT ET les empreintes des codes OTP. 32 caracteres minimum.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="valeur-de-developpement-a-remplacer-en-production"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fichiers ecrits dans public/uploads. Developpement UNIQUEMENT.
STORAGE_DRIVER="local"

# Le code OTP s'affiche dans la console du serveur, aucun e-mail n'est envoye.
# Ce mode REFUSE de fonctionner si NODE_ENV=production.
EMAIL_DRIVER="dev"


# #############################################################################
#                                PRODUCTION
#   Remplace les valeurs ci-dessus. Toutes ces variables sont necessaires,
#   sauf mention « facultatif ».
# #############################################################################

# --- Base de donnees ---------------------------------------------------------
# PostgreSQL manage (Neon). Basculer d'abord le provider :
#   node scripts/basculer-postgres.mjs --appliquer
#
# Neon expose DEUX chaines de connexion, et les deux sont necessaires :
#   DATABASE_URL           connexion GROUPEE  (hote en -pooler) -> application
#   DATABASE_URL_UNPOOLED  connexion DIRECTE  (sans -pooler)    -> prisma migrate
#
# Neon > Connect : cochez / decochez « Connection pooling » pour obtenir l'une
# puis l'autre. Ajoutez ?sslmode=require&connect_timeout=15 si absent.
#
# DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DATABASE_URL_UNPOOLED="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Securite ----------------------------------------------------------------
# Valeur DIFFERENTE de celle de developpement. La modifier deconnecte tout le
# monde et invalide les codes de verification en cours.
# AUTH_SECRET="…"

# Domaine public reel, sans barre finale. Sert aux QR codes des certificats
# et aux liens contenus dans les e-mails.
# NEXT_PUBLIC_APP_URL="https://sdesignshop.com"

# INDISPENSABLE DERRIERE CLOUDFLARE.
# Next 14 compare l'en-tete Origin a Host / X-Forwarded-Host et rejette les
# server actions si elles different. Sans cette liste, TOUS les formulaires
# cessent de fonctionner : inscription, OTP, connexion, reservation, parametres.
# Domaines separes par des virgules, sans protocole.
# SERVER_ACTIONS_ORIGINS="sdesignshop.com,www.sdesignshop.com"

# --- Stockage des fichiers (Cloudflare R2) -----------------------------------
# public/uploads N'EST PAS utilisable en production : les fichiers ecrits sur le
# disque du serveur disparaissent a chaque deploiement.
# STORAGE_DRIVER="r2"

# Tableau de bord Cloudflare > R2. Jeton « Object Read & Write » sur le bucket.
# Les cinq variables forment un tout : il en manque une et R2 reste inactif.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""

# Domaine public du bucket (sous-domaine r2.dev ou domaine personnalise), sans
# barre finale. C'est l'URL qui apparaitra dans les balises <img> du site.
# R2_PUBLIC_URL=""

# --- Messagerie (Brevo) ------------------------------------------------------
# EMAIL_DRIVER="brevo"

# Brevo > Parametres > SMTP & API > Cles API.
# BREVO_API_KEY=""

# L'adresse doit etre validee dans Brevo (expediteur confirme, ou domaine
# authentifie SPF/DKIM), sinon les messages sont refuses ou classes indesirables.
# BREVO_SENDER_EMAIL="contact@sdesignshop.com"
# BREVO_SENDER_NAME="S.DESIGN SHOP"

# --- Compte administrateur ---------------------------------------------------
# Identifiants du back-office. Lus UNIQUEMENT par la graine et par
# scripts/provisionner-admin.mjs ; l'application, elle, ne les lit jamais.
#
# Aucun mot de passe n'est ecrit en dur dans le code : sans ces variables, la
# graine s'arrete plutot que de fabriquer un acces devinable.
#
# ADMIN_PHONE doit etre saisi EXACTEMENT comme il servira a se connecter :
# l'ecran de connexion compare le numero caractere pour caractere, espaces
# compris.
#
# Creer ou renouveler ce seul compte, sans toucher au reste des donnees :
#   node --env-file=.env scripts/provisionner-admin.mjs
#
# Retirez ADMIN_PASSWORD de .env une fois la connexion verifiee.
# ADMIN_EMAIL=""
# ADMIN_PHONE=""
# ADMIN_PASSWORD=""          # 12 caracteres minimum, avec majuscule et chiffre

# --- Facultatif --------------------------------------------------------------
# Logo de secours si aucun logo n'est televerse dans Admin > Parametres.
# En fonctionnement normal, le logo officiel vient de la base : laisser vide.
# BRAND_LOGO_URL=""


# =============================================================================
# RECAPITULATIF
#
#   Developpement    DATABASE_URL, AUTH_SECRET
#                    (STORAGE_DRIVER=local et EMAIL_DRIVER=dev suffisent)
#
#   Production       DATABASE_URL, DATABASE_URL_UNPOOLED, AUTH_SECRET,
#                    NEXT_PUBLIC_APP_URL,
#                    SERVER_ACTIONS_ORIGINS,
#                    STORAGE_DRIVER=r2, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
#                    R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_PUBLIC_URL,
#                    BREVO_API_KEY, BREVO_SENDER_EMAIL
#
#   Facultatif       EMAIL_DRIVER, BREVO_SENDER_NAME, BRAND_LOGO_URL
#
#   Graine / script  ADMIN_EMAIL, ADMIN_PHONE, ADMIN_PASSWORD
#                    (jamais lues par l'application en fonctionnement)
#
# Verification une fois configure :
#   npm run verifier:sigv4                       (aucune cle requise)
#   npm run verifier:r2
#   node --env-file=.env scripts/verifier-brevo.mjs vous@exemple.com
#   node --env-file=.env scripts/verifier-images.mjs https://sdesignshop.com
# =============================================================================
